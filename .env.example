# Copy this file to backend/.env. Defaults work without a key.
# Use mock for local deterministic processing, or gemini for LLM processing.
# Gemini requires GEMINI_API_KEY. Restart the backend after changing providers.
EXTRACTION_PROVIDER=mock
MAX_CONCURRENCY=4
MOCK_DELAY_MS=650
PROVIDER_TIMEOUT_SECONDS=30
TICKETS_PATH=data/tickets.jsonl

# Optional real LLM mode. These variables are ignored by the mock provider.
# Set EXTRACTION_PROVIDER=gemini after adding your own key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Next.js forwards /api requests to this backend in development and production.
# Set before frontend startup/build; root .env and frontend/.env.local are supported.
BACKEND_URL=http://127.0.0.1:8000
