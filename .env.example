# Copy this file to .env in the repository root. Defaults work without copying.
EXTRACTION_PROVIDER=mock
MAX_CONCURRENCY=4
MOCK_DELAY_MS=650
PROVIDER_TIMEOUT_SECONDS=30
TICKETS_PATH=data/tickets.jsonl

# Optional real LLM mode. These variables are ignored by the mock provider.
# Select gemini only after adding your own key; no key is needed for grading.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Vite forwards /api requests to this backend during development.
BACKEND_URL=http://127.0.0.1:8000

# Browser API prefix. For the dev proxy, leave this as /api.
# For a separate production backend, use its full URL including /api.
VITE_API_BASE_URL=/api
