{
  "name": "extraction-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src next.config.ts vitest.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src next.config.ts vitest.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next": "16.3.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
